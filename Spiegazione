│   ├── completo.py      # Sottoclasse
│   ├── finitura.py      # Classe base per i componenti di finitura
│   ├── papillon.py      # Sottoclasse finitura
│   └── ...
│
├── manager/
│   └── sartoria_manager.py  # UN'UNICA classe gestionale polimorfica
│
└── utils/
